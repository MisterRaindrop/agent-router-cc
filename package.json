{
  "name": "agent-router-cc",
  "version": "0.8.5",
  "description": "Task-routing CLI + Claude Code plugin (router). The main session plans, reviews and verifies; the CLI owns worktree isolation, supervision, concurrency, and environment-free gates on every diff.",
  "type": "module",
  "bin": {
    "router": "dist/router.js"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "docs/",
    "schema/",
    ".claude-plugin/",
    "commands/",
    "references/",
    "agents/",
    "hooks/"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check:deps": "node scripts/check-deps.mjs",
    "check": "npm run typecheck && npm run check:deps && npm run test"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "js-yaml": "5.2.3",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.26.12"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  },
  "license": "Apache-2.0",
  "author": "The agent-router-cc Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MisterRaindrop/agent-router-cc.git"
  },
  "homepage": "https://github.com/MisterRaindrop/agent-router-cc#readme",
  "bugs": {
    "url": "https://github.com/MisterRaindrop/agent-router-cc/issues"
  },
  "keywords": [
    "claude-code",
    "claude-code-plugin",
    "llm-orchestration",
    "ai-agents",
    "code-review",
    "token-optimization",
    "codex",
    "git-worktree"
  ]
}
